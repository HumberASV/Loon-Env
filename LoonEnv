###############################
# Display usage information
# Globals:
#  None
# Arguments:
#  None
# Outputs:
#  Prints usage information to stdout
###############################
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]
Options:
  -h, --help        Show this help message and exit
  -v, --verbose     Enable verbose output
  -i, --install-deps  Install required dependencies
  --dry-run         Show what would be done without making any changes
  --version         Show the version of the installer and exit
  -r, --remove      Remove Loon-Env installation
  -s, --skip        Skip installation of scripts and MTU configuration
  -f, --force [COMPONENT] [COMPONENT] [COMPONENT] [OPTION]
    not all components are required, you can specify one or more components to force install, and optionally skip the other components
    Force installation of a specific component (docker, loone, zed)
    components:
        docker - Force install the docker files in the workspace, overwriting any existing files without prompting
        loone - Force install the LoonE files in the workspace, overwriting any existing files without prompting
        zed - Force install the ZED ROS2 Wrapper files in the workspace, overwriting any existing files without prompting
    option:
        -s, --skip skips install of the other components, including MTU configuration


EOF
}

###############################
# Display version information
# Globals:
#  VERSION
# Arguments:
#  None
# Outputs:
#  Prints version information to stdout
###############################
version() {
    echo "$APP_NAME Installer version $VERSION"
}

#################################
# Logs a message if verbose mode is enabled
# Globals:
#  VERBOSE
# Arguments:
#  msg - The message to log
# Outputs:
#  Prints the message to stdout if verbose mode is enabled
#################################
log() {
    if [[ "$VERBOSE" -eq 1 ]]; then
        echo "${GREEN}${BOLD}[INFO] ${PRIMARY}$*"
    fi
}

#################################
# Prints an error message to stderr
# Globals:
#  RED
#  BOLD
#  PRIMARY
# Arguments:
#  msg - The message to log
# Outputs:
#  Prints the message to stderr
#################################
error() {
    echo "${RED}${BOLD}[ERROR] ${PRIMARY}$*" >&2
}

#################################
# Prints a warning message to stderr
# Globals:
#  ORANGE
#  BOLD
#  PRIMARY
# Arguments:
#  msg - The message to log
# Outputs:
#  Prints the message to stderr
#################################
warn() {
    echo "${ORANGE}${BOLD}[WARN] ${PRIMARY}$*" >&2
}

#################################
# Executes a command, respecting dry-run mode
# Globals:
#  DRY_RUN
# Arguments:
#  cmd - The command to execute as a string or array
# Outputs:
#  Executes the command if not in dry-run mode, otherwise prints it
run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${YELLOW}${BOLD}[DRY RUN] ${PRIMARY}$*"
    else
        eval "$@"
    fi
}

# >>> Utility Functions <<<


#######################################
# Asks on stdout using read for confirmation
# Globals:
# BOLD
# PRIMARY
# REPLY
# Arguments:
#   $1 - prompt string
# Returns:
#   0 if yes
#   1 if no
#######################################
confirm() {
    local prompt="${1:-Are you sure?}"
    local REPLY
    while true; do
        read -n 1 -r -p "${prompt} ${BOLD}[y/n]${PRIMARY}: " REPLY
        printf "\n"
        case "$REPLY" in
            [Yy]) return 0;;
            [Nn]) return 1;;
            *) printf "Please enter y or n.\n";;
        esac
    done
}

#######################################
# Create lock file to prevent concurrent installations
# Globals:
#  LOCKFILE
# Arguments:
#  None
# Outputs:
#  Writes the current process ID to the lock file
#######################################
create_lock() {
    log "Creating installation lock at $LOCKFILE..."
    run 'echo "$$" > "$LOCKFILE"'    
}

#########################################
# Remove lock file on exit
# Globals:
#  LOCKFILE
# Arguments:
#  None
# Outputs:
#  Removes the lock file
#########################################
cleanup() {
    log "Cleaning up installation lock..."
    run rm -f "$LOCKFILE"
}

#########################################
# Check if the script is run as root
# Globals:
#  EUID
# Arguments:
#  None
# Outputs:
#  Exits with an error message if run as root
#########################################
require_non_root() {
    if [[ "$EUID" -eq 0 ]]; then
        error "This installer must not be run as root. Please use a regular user account."
        exit 1
    fi
}

#######################################
# Check if a required command is available
# Globals:
#  INSTALL_DEPS
# Arguments:
#  cmd - The command to check for
#  error_msg - Optional custom error message to display if the command is not found
# Outputs:
#  Exits with an error message if the command is not found
#######################################
require_command() {
    log "Checking for required command: $1"
    local cmd="$1"
    local error_msg="${2:-Error: Required command '$cmd' not found. Please install it and try again.}"
    if ! command -v "$cmd" &> /dev/null; then
        error "$error_msg"
        exit 1
    fi
}


########################################
# Unlike require_command, 
# this function will attempt to install the dependency if it's not found
# Globals:
#  INSTALL_DEPS
# Arguments:
#  cmd - The command to check for
#  msg - message
#  install_cmd - The command to install the dependency if it's not found
# Outputs:
#  Installs the dependency if it's not found, otherwise does nothing
########################################
install_dependency() {
    log "Checking for dependency: $1"
    local cmd="$1"
    local msg="$2"
    local install_cmd="$3"
    if ! command -v "$cmd" &> /dev/null; then
        if [[ "$INSTALL_DEPS" -eq 1 ]]; then
            log "$1 is not found. Installing dependency: $cmd"
            run "$install_cmd"
        else
            error $msg || "Required command '$cmd' not found. Please install it and try again."
            exit 1
        fi
    fi
}

########################################
# Check if ZED SDK is installed and get its version
# Globals:
#  ZED_VERSION
# Arguments:
#  None
# Outputs:
#  Exits with an error message if ZED SDK is not found, otherwise sets ZED_VERSION variable
########################################
require_zedsdk() {
    log "Checking for ZED SDK installation at /usr/local/zed..."
    if [[ -f "/usr/local/zed/zed-config-version.cmake" ]]; then
        ZED_VERSION=$(sudo cat /usr/local/zed/zed-config-version.cmake | grep "set(PACKAGE_VERSION \"" | sed -E 's/set\(PACKAGE_VERSION "(.*)"\)/\1/')
        log "Found ZED SDK version $ZED_VERSION"
    else
        error "ZED SDK not found. Please install it and try again."
        exit 1
    fi
}

#######################################
# Migrate old installation if it exists
# Globals:
#  None
# Arguments:
#  None
# Outputs:
#  Moves old installation directory to new location if it exists
#######################################
migrate_old_installation() {
    log "Checking for existing installation at $HOME/.loon-env..."
    local old_path="$HOME/.loon-env"
    local new_path="/opt/loon-env"

    if [[ -d "$old_path" ]]; then
        log "Migrating existing installation from $old_path to $new_path..."
        run sudo mv "$old_path" "$new_path"
        log "Migration complete."
    fi
}

##################################
# Apply host network buffer tuning for large DDS messages
# Globals:
#  ASSETS_DIR
# Arguments:
#  None
# Outputs:
#  Copies the buffer profile into /etc/sysctl.d and loads it
##################################
apply_buffers() {
    local source_file="$ASSETS_DIR/buffers.conf"
    local target_file="/etc/sysctl.d/60-loon-env-buffers.conf"

    log "[Install Config] Applying host buffer tuning from $source_file"

    if [[ ! -f "$source_file" ]]; then
        error "Buffer profile not found at $source_file"
        exit 1
    fi

    run 'sudo cp '"$source_file"' '"$target_file"
    run 'sudo sysctl -p '"$target_file"

    log "[Install Config] Host buffer tuning applied from $source_file to $target_file"
}

##################################
# Parse command-line arguments
# Globals:
#  VERBOSE
#  DRY_RUN
# Arguments:
#  All command-line arguments
# Outputs:
#  Sets global variables based on the provided arguments
##################################
parse_arguments() {

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            --version) version; exit 0 ;;
            -v|--verbose) VERBOSE=1 ;;
            -i|--install-deps) INSTALL_DEPS=1 ;;
            --dry-run) DRY_RUN=1 ;;
            -s|--skip) SKIP_OTHER_COMPONENTS=1 ;;
            -r|--remove) remove_loon_env; exit 0 ;;
            -f|--force)
                get_force "$@"
                break
                ;;
            *) error "Unknown option: $1"; usage; exit 1 ;;
        esac
        shift
    done
}

get_force(){

    while [[ "$#" -gt 1 ]]; do
        case "$2" in
            docker) FORCE_DOCKER_INSTALL=1 ;;
            loone) FORCE_LOONE_INSTALL=1 ;;
            zed) FORCE_ZED_INSTALL=1 ;;
            -s|--skip) SKIP_OTHER_COMPONENTS=1 ;;
            *) break ;;
        esac
        shift
    done
}

