# Install Loon-Env by copying assets and the main script to their respective locations
# Globals:
#  VERSION
#  PATH_INSTALL
#  ASSETS_DIR
#  LOONDOCK_SOURCE
#  LOONDOCK_SCRIPT_INSTALL
# Arguments:
#  None
# Outputs:
#  Copies assets to installation directory, overwrites existing files, and installs the main script to /usr/local/bin
#######################################
install_loon_env() {
    migrate_old_installation
    log "[Install ENV] Installing Loon-Env assets of $VERSION to $PATH_INSTALL"
    run "sudo mkdir -p  $PATH_INSTALL/assets"
    run "sudo mkdir -p $WORKSPACE_DIR"

    log "[Install ENV] Copying assets or overwriting to $PATH_INSTALL/assets"
    run "rm -rf $PATH_INSTALL/assets/*"
    run "sudo cp -r $ASSETS_DIR/. $PATH_INSTALL/assets/"

    # asset permissions to group and read/write for owner and group, read for others
    log "[Install ENV] Setting permissions for $PATH_INSTALL/assets to group ownership of $GROUP_NAME and read write for owner and group, read for others"
    run "sudo chown -R :$GROUP_NAME $PATH_INSTALL/assets"
    run "sudo chmod -R 774 $PATH_INSTALL/assets"

    log "[Install ENV] Loon-Env assets installed to $PATH_INSTALL/assets with permissions set."

    log "[Install ENV] Setting ownership for $PATH_INSTALL to $USERNAME:$GROUP_NAME"
    run "sudo chown -R $USERNAME:$GROUP_NAME $PATH_INSTALL"

    log "[Install ENV] Moving copy of Loon-Env script to $LOONDOCK_SCRIPT_INSTALL"
    run "sudo mkdir -p $(dirname $LOONDOCK_SCRIPT_INSTALL)"
    if [[ ! -f "$LOONDOCK_SOURCE" ]]; then
        error "LoonDock source not found at $LOONDOCK_SOURCE"
        exit 1
    fi
    run "sudo rm -f $LOONDOCK_SCRIPT_INSTALL"
    run "sudo cp $LOONDOCK_SOURCE $LOONDOCK_SCRIPT_INSTALL"

    log "[Install ENV] Loon-Env script copied to $LOONDOCK_SCRIPT_INSTALL"

    # Set group ownership and permissions for the script
    run "sudo chown :$GROUP_NAME $LOONDOCK_SCRIPT_INSTALL"

    # Make the script executable
    run "sudo chmod 755 $LOONDOCK_SCRIPT_INSTALL"

    log "[Install ENV] Permissions set for $LOONDOCK_SCRIPT_INSTALL: group ownership to $GROUP_NAME and executable by all users."

    # Verify installation
    if [[ -f "$LOONDOCK_SCRIPT_INSTALL" ]]; then
        log "[Install ENV] Loon-Env script installed successfully at $LOONDOCK_SCRIPT_INSTALL."
    else
        error "Failed to install Loon-Env script."
        exit 1
    fi

    # verify assets installation
    if [[ -d "$PATH_INSTALL/assets" ]]; then
        log "[Install ENV] Loon-Env assets installed successfully at $PATH_INSTALL/assets."
    else
        error "Failed to install Loon-Env assets."
        exit 1
    fi

    log "[Setup Workspace] Setting ownership for workspace directories to $USERNAME:$GROUP_NAME"
    run "sudo chown -R $USERNAME:$GROUP_NAME $WORKSPACE_DIR"
    run "sudo chmod -R 775 $WORKSPACE_DIR"
}
