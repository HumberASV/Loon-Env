#################################
# Create a group for Loon-Env users and add the current user to it
# Checks if user "robo" exist and creates it if it doesn't, then adds it to the group
# Globals:
#  GROUP_NAME
#  USERNAME
# Arguments:
#  None
# Outputs:
#  Creates a group for Loon-Env users if it doesn't exist and adds the current user to it
#################################
create_group_and_add_user() {
    log "Creating group $GROUP_NAME if it doesn't exist..."
    if ! getent group "$GROUP_NAME" > /dev/null; then
        run sudo groupadd "$GROUP_NAME"
        log "Group $GROUP_NAME created successfully."
    else
        log "Group $GROUP_NAME already exists. Skipping group creation."
    fi

    log "Adding user $USERNAME to group $GROUP_NAME..."
    if id -nG "$USERNAME" | grep -qw "$GROUP_NAME"; then
        log "User $USERNAME is already in group $GROUP_NAME. Skipping user addition."
    else
        run sudo usermod -aG "$GROUP_NAME" "$USERNAME"
        log "User $USERNAME added to group $GROUP_NAME successfully."
    fi

    # create robo user if it doesn't exist and add to group
    if ! id -u "robo" > /dev/null 2>&1; then
        log "Creating user robo and adding to group $GROUP_NAME..."
        run sudo useradd -m -s /bin/bash -G "$GROUP_NAME" robo
        log "User robo created and added to group $GROUP_NAME successfully."
    else
        log "User robo already exists. Skipping user creation."
        # Check if robo is in the group
        if id -nG "robo" | grep -qw "$GROUP_NAME"; then
            log "User robo is already in group $GROUP_NAME. Skipping user addition."
        else
            run sudo usermod -aG "$GROUP_NAME" robo
            log "User robo added to group $GROUP_NAME successfully."
        fi
    fi
}

#################################
# Installation function that checks for dependencies, and optionally installs
# Globals:
#  INSTALL_DEPS
# Arguments:
#  None
# Outputs:
#  Installs dependencies if --install-deps is specified, migrates old installation if it exists, and installs Loon-Env
################################
installation() {

    # Requirements for installing docker, ros, and zedsdk
    if [[ "$INSTALL_DEPS" -eq 1 ]]; then
        log "[Installation] Require APT-GET for dependency installation"
        require_command "apt-get" \
            "apt-get is required to install dependencies. Please install apt-get or use install without --install-deps and try again." 

        log "[Installation] Require curl for dependency installation"

        install_dependency "curl" \
            "curl is required to download dependencies. Please install curl and try again." \
            "sudo apt-get update && sudo apt-get install -y curl"

        install_dependency "gnupg" \
            "gnupg is required to add package repositories. Please install gnupg and try again." \
            "sudo apt-get update && sudo apt-get install -y gnupg"
        
        install_dependency "lsb-release" \
            "lsb-release is required to detect the operating system version. Please install lsb-release and try again." \
            "sudo apt-get update && sudo apt-get install -y lsb-release"
        
        install_dependency "ca-certificates" \
            "ca-certificates is required to securely download dependencies. Please install ca-certificates and try again." \
            "sudo apt-get update && sudo apt-get install -y ca-certificates"

        install_dependency "gpg" \
            "gpg is required to verify package signatures. Please install gpg and try again." \
            "sudo apt-get update && sudo apt-get install -y gpg"

        install_docker
        install_ros
        
        install_zedsdk
    fi

    install_dependency "wget" \
            "wget is required to download dependencies. Please install wget and try again." \
            "sudo apt-get update && sudo apt-get install -y wget"

    install_dependency "git" \
        "git is required to clone the Loon-E repository. Please install git and try again." \
        "sudo apt-get update && sudo apt-get install -y git"

    log "[Installation] Git is available. Proceeding with installation."

    # Check for NVIDIA GPU and drivers
    require_command "nvidia-smi" \
        "NVIDIA GPU not detected. Ensure you are using Jetpack on a compatible NVIDIA Jetson device with proper drivers installed."


    log "[Installation] Checking zed sdk installation..."
    require_zedsdk

    log "[Installation] All dependencies are installed. Proceeding with Loon-Env installation."
}

################################
# Set up environment variables for the workspace and docker images
# Globals:
#  WORKSPACE_DIR
# Arguments:
#  None
# Outputs:
#  Exports environment variables for the workspace and docker images
################################
set_variables() {
    log "[Set Variables] Checking for existing environment variable setup in ~/.loon_env_setup.bash..."
    if [[ -f "$HOME/.loon_env_setup.bash" ]]; then
        log "[Set Variables] Existing environment variable setup found. Skipping variable setup."
        
    else
        log "[Set Variables] No existing environment variable setup found. Creating ~/.loon_env_setup.bash and exporting variables..."
        # Point LOONE_FILES_DIR at the installed assets directory (not the root install path)
        run 'echo "export LOONE_FILES_DIR='$PATH_INSTALL'/assets" >> ~/.loon_env_setup.bash'
        run 'echo "export LOONE_WORKSPACE_DIR='$WORKSPACE_DIR'" >> ~/.loon_env_setup.bash'
        run 'echo "export LOONE_SETUP_SCRIPT='$HOME'/.loon_env_setup.bash" >> ~/.loon_env_setup.bash'
        run 'echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.loon_env_setup.bash'
        run 'echo "export ROS_DOMAIN_ID=0" >> ~/.loon_env_setup.bash'
        run 'echo "export ROS_LOCALHOST_ONLY=0" >> ~/.loon_env_setup.bash'
        run 'echo "export ZED_SDK_VERSION='$ZED_VERSION'" >> ~/.loon_env_setup.bash'
        run 'echo "export XAUTHORITY=/home/'$(whoami)'/.Xauthority" >> ~/.loon_env_setup.bash'
        run 'echo "export L4T_VERSION='$L4T_VERSION'" >> ~/.loon_env_setup.bash'
        run 'echo "export CYCLONEDDS_URI=file:///opt/cyclonedds.xml" >> ~/.loon_env_setup.bash'
        # Default wrapper ref: streaming for virtual builds, zedx for hardware builds (LoonDock will override per-profile)
        run 'echo "export ZED_WRAPPER_GIT_REF=zedx" >> ~/.loon_env_setup.bash'
        log "[Set Variables] Environment variables set and exported to ~/.loon_env_setup.bash"
    fi
    log "[Set Variables] Setting ~/.bashrc to source ~/.loon_env_setup.bash if it exists"
    if ! grep -q "source ~/.loon_env_setup.bash" ~/.bashrc; then
        run 'echo "source ~/.loon_env_setup.bash">> ~/.bashrc'
        log "[Set Variables] Added source command to ~/.bashrc"
    else
        log "[Set Variables] Source command already exists in ~/.bashrc. Skipping."
    fi

    log "[Set Variables] Setting group permissions for $GROUP_NAME to access $PATH_INSTALL"
    run "sudo chown -R :$GROUP_NAME $PATH_INSTALL"
    log "[Set Variables] Done. Setting permissions to 755 for ~/.loon_env_setup.bash"
    run 'chmod 755 ~/.loon_env_setup.bash'
    log "[Set Variables] Permissions set for ~/.loon_env_setup.bash"
    
    log "[Set Variables] Environment variable setup complete."
}


download_dependencies_for_zed_wrapper() {
     # ZED ROS2 Wrapper dependencies version
    local XACRO_VERSION=2.0.8
    local DIAGNOSTICS_VERSION=4.0.0
    local AMENT_LINT_VERSION=0.12.11
    local ROBOT_LOCALIZATION_VERSION=3.5.3
