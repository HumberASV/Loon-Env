#################################
# Checks a repo for updates and asks
# Globals:
# None
# Arguements:
# $1 - Repository location
# $2 - Repository name for logging purposes
# $3 - Force update flag, if set to 1, will pull updates without confirmation
#################################
check_repo(){
    local repoLocation="$1"
    local name="$2"
    local forceFlag="$3" || 0;
    log "[Git Check] For updates at $name repository at $repoLocation"
    local git=$(cd $repoLocation && git fetch --dry-run -v)
    if [[ -n "$git" ]]; then
        log "[Git Check] Updates found for $name repository. Pulling latest changes..."
        if [[ "$forceFlag" -eq 1 ]]; then
            log "[Git Check] Force flag is set for $name repository. Pulling latest changes without confirmation..."
            run "(cd $repoLocation && git pull)"
        else
            if confirm "Updates found for $name repository. Do you want to pull the latest changes?"; then
                run "(cd $repoLocation && git pull)"
                echo "[Git Check] $name repository updated successfully."
            else
                log "[Git Check] Skipping update for $name repository."
            fi
        fi
    else
        log "[Git Check] No updates found for $name repository."
    fi
}

#################################
# Clones a repo into the workspace if the target directory is missing/empty.
# If it already exists and is non-empty, offers to remove and re-clone
# (respecting a force flag/confirm), otherwise falls back to check_repo()
# to look for upstream updates on the existing clone.
# Globals:
# None
# Arguments:
# $1 - repo_url
# $2 - target_dir
# $3 - ref (branch/tag/commit to check out after cloning; may be empty)
# $4 - force_flag
# $5 - friendly name for logging
#################################
clone_workspace_repo() {
    local repo_url="$1"
    local target_dir="$2"
    local ref="$3"
    local force_flag="$4"
    local name="$5"

    if [[ ! -d "$target_dir" || ! $(ls -A "$target_dir" 2>/dev/null) ]]; then
        log "[Setup Workspace] Cloning $name into $target_dir..."
        run "git clone --recurse-submodules '$repo_url' '$target_dir'"
        [[ -n "$ref" ]] && run "(cd '$target_dir' && git fetch --all --tags && git checkout '$ref' && git submodule update --init --recursive)"
    else
        warn "Existing ${BLUE}$name${PRIMARY} clone found at ${BLUE}$target_dir${PRIMARY} but it is not empty."
        if [[ "$force_flag" -eq 1 ]] || confirm "Remove and re-clone $name at $target_dir? (this discards any local changes)"; then
            [[ "$force_flag" -eq 1 ]] && log "Force flag set for $name. Re-cloning..."
            run "rm -rf '$target_dir'"
            run "git clone --recurse-submodules '$repo_url' '$target_dir'"
            [[ -n "$ref" ]] && run "(cd '$target_dir' && git fetch --all --tags && git checkout '$ref' && git submodule update --init --recursive)"
        else
            log "[Setup Workspace] Skipping re-clone of $name; checking for upstream updates instead..."
            check_repo "$target_dir" "$name" "$force_flag"
        fi
    fi
}

