###############################
# Sets up our workspace and downloads the git repositories for docker use
# Globals:
#  WORKSPACE_DIR
# Arguments:
#  None
# Outputs:
#  Creates the ROS 2 workspace directory structure and source file for environment variables
###############################
setup_workspace() {


    local src_dir="$WORKSPACE_DIR"

    log "[Setup Workspace] Creating ROS 2 workspace at $WORKSPACE_DIR..."
    run 'mkdir -p '$src_dir
    run 'mkdir -p '$WORKSPACE_DIR'/zed_ws/src'
    run 'mkdir -p '$WORKSPACE_DIR'/loon_ws'
    run 'mkdir -p '$WORKSPACE_DIR'/docker'

    log "[Setup Workspace] Cloning$BLUE loon_ws$PRIMARY (Loon-E) into $WORKSPACE_DIR/loon_ws if needed..."

    loon_ws() {
        clone_workspace_repo "https://github.com/HumberASV/loon-e.git" \
            "$WORKSPACE_DIR/loon_ws" "main" "$FORCE_LOONE_INSTALL" "loon_ws (Loon-E)"
    }

    zed_ws() {
        clone_workspace_repo "https://github.com/HumberASV/zed-ros2-wrapper.git" \
            "$WORKSPACE_DIR/zed_ws/src/zed_ros2_wrapper" "$ZED_WRAPPER_DEFAULT_REF" "$FORCE_ZED_INSTALL" "zed_ros2_wrapper"
        clone_workspace_repo "https://github.com/stereolabs/zed-ros2-examples.git" \
            "$WORKSPACE_DIR/zed_ws/src/zed_ros_examples" "master" "$FORCE_ZED_INSTALL" "zed_ros_examples"
        clone_workspace_repo "https://github.com/stereolabs/zed-ros2-interfaces.git" \
            "$WORKSPACE_DIR/zed_ws/src/interfaces" "5.3.0" "$FORCE_ZED_INSTALL" "zed-ros2-interfaces"
        download_dependencies_for_zed_wrapper
    }

    docker_ws() {
        log "[Setup Workspace] Moving ./src/docker to $WORKSPACE_DIR/docker if it exists..."
        if [[ ! $(ls -A $WORKSPACE_DIR/docker) ]]; then
            run cp -r "./src/docker" "$WORKSPACE_DIR"
            log "[Setup Workspace] Moved$BLUE docker$PRIMARY to workspace directory."
        else #not empty
            warn "Existing$BLUE docker$PRIMARY found in$BLUE $WORKSPACE_DIR/docker $PRIMARY but it is not empty."
            if [[ "$FORCE_DOCKER_INSTALL" -eq 1 ]] || \
                confirm "Do you want to overwrite the existing$BLUE docker$PRIMARY in the workspace directory with the one in $BLUE./src?$PRIMARY"; then
                if [[ "$FORCE_DOCKER_INSTALL" -eq 1 ]]; then
                    log "Force flag for Docker installation is set. Overwriting existing docker in workspace directory with the one in ./src..."
                fi
                run rm -rf "$WORKSPACE_DIR/docker/"
                run cp -r "./src/docker" "$WORKSPACE_DIR"
                log "[Setup Workspace] Moved$BLUE docker$PRIMARY to workspace directory."
            else
                log "[Setup Workspace] Skipping move of$BLUE docker$PRIMARY to workspace directory."
            fi
        fi
    }

    log "[Setup Workspace] Checking for existing workspace components and handling according to flags and user input..."
    local installs=("loon_ws"
        "zed_ws"
        "docker"
    )

    if [[ "$SKIP_OTHER_COMPONENTS" -eq 1 ]]; then
        log "[Setup Workspace] Skip other components flag is set. Only installing components with force flags."
        installs=()
        if [[ "$FORCE_LOONE_INSTALL" -eq 1 ]]; then
            installs+=("loon_ws")
        fi
        if [[ "$FORCE_ZED_INSTALL" -eq 1 ]]; then
            installs+=("zed_ws")
        fi
        if [[ "$FORCE_DOCKER_INSTALL" -eq 1 ]]; then
            installs+=("docker")
        fi

        log "[Setup Workspace] Components marked for installation: ${installs[*]}"
        if [[ ${#installs[@]} -eq 0 ]]; then
            log "[Setup Workspace]$ORANGE No components marked for installation.$PRIMARY Skipping workspace setup."
            return
        fi

        for component in "${installs[@]}"; do
            case $component in
                "loon_ws") loon_ws ;;
                "zed_ws") zed_ws ;;
                "docker") docker_ws ;;
            esac
        done
    else # not skipping, install all components
        loon_ws
        zed_ws
        docker_ws
    fi
    

    log "[Setup Workspace] Subdirectories for loon_e and zedx created in workspace src."
}

