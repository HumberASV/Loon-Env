# Version
LOONE_VERSION="4.0.0"

# Names for Docker images and containers
ZED_IMAGE_NAME="loon_zed_img"
LOON_E_IMAGE_NAME="loon_e_img"
ZED_CONTAINER_NAME="loon_zed_container"
LOON_E_CONTAINER_NAME="loon_e_container"

# Asset directory and workspace directory with defaults
ASSET_DIR="${ASSET_DIR:-/usr/share/Loon-Env}"
LOONE_WORKSPACE_DIR="${LOONE_WORKSPACE_DIR:-$HOME/LoonE_ws}"
COMPOSE_FILE="$LOONE_WORKSPACE_DIR/docker/compose.yaml"

# Global variables for build options
BUILD_PROFILE=""
BUILD_NO_CACHE=0

#---------------------- FUNCTIONS ------------------
# Display command usage and option help text.
# Version: 2.0.0
# Returns:
#   None: if help text is printed successfully.
show_help() {
        cat <<'EOF'
Usage: LoonE [OPTIONS]

The LoonE script is a convenient wrapper for managing the Docker environment for the Loon-E project. 
It can build the Docker image, start the container, and enter it with a single command. :)

Options:
    -h, --help   show this help message and exit
    -s, --start  start the Docker container if it's not running
        --stop [SERVICE ...]  stop compose services
                            services: zed loone all
    -e, --enter  enter the Docker container
    -b, --build   build and run services
    -q, --quack   what does this do? Try it and find out!
    -v, --version   show version information and exit

Build options:
    --zed          Builds only the `zed` service image. Accepts optional profile argument: `
    virtual` or `zedx`.
    --loone        Builds only the `loone` service image. Accepts optional profile argument
    : `virtual` or `zedx`.
    -n, --no-cache Use Docker build without cache. Supported with `--build`, `--build-zed`, and `--build-loone`.
    -v, --virtual   Sets build profile to `virtual`
    -x, --zedx      Sets build profile to `zedx`
EOF
}

# Stop compose services.
# Parameters:
#   $@ (optional): zero or more targets from zed, loone, all
# Defaults:
#   Stops both zed and loone when no targets are provided.
stop_services() {
    local targets=()
    local arg

    if [ "$#" -eq 0 ]; then
        targets=(zed loone)
    else
        for arg in "$@"; do
            case "$arg" in
                all)
                    targets=(zed loone)
                    ;;
                zed|loone)
                    targets+=("$arg")
                    ;;
                *)
                    echo "Error: unknown stop target '$arg'."
                    echo "Allowed targets: zed, loone, all."
                    return 1
                    ;;
            esac
        done
    fi

    # Deduplicate while preserving first-seen order.
    local deduped=()
    local seen=""
    for arg in "${targets[@]}"; do
        case " $seen " in
            *" $arg "*) ;;
            *)
                deduped+=("$arg")
                seen="$seen $arg"
                ;;
        esac
    done

    echo "Stopping services: ${deduped[*]}"
    docker compose -f "$COMPOSE_FILE" stop "${deduped[@]}"
}

# Version: 3.0.0
# Parse optional build arguments after a build flag.
# Build options:
# - `--zed`
#   Builds only the `zed` service image.
#   Accepts optional profile argument: `virtual` or `zedx`.
# - `--loone`
#   Builds only the `loone` service image.
#   Accepts optional profile argument: `virtual` or `zedx`.
# - `-n`, `--no-cache`
#   Use Docker build without cache. Supported with `--build`, `--build-zed`, and `--build-loone`.
# - `-v`, `--virtual`
#   Sets build profile to `virtual`, which configures the ZED wrapper for simulation use (sets `ZED_SIM_MODE=true` and `ZED_USE_SIM_TIME=true`).
# - `-x`, `--zedx`
#   Sets build profile to `zedx`, which configures the ZED wrapper for hardware use (sets `ZED_SIM_MODE=false` and `ZED_USE_SIM_TIME=false`).
build() {
    # Parse build options
    BUILD_PROFILE="" # zed, loone, both
    BUILD_CACHE="" # flag for --no-cache
    BUILD_FOR_HARDWARE="" # flag for hardware profile (if not set, defaults to virtual)

    for arg in "$@"; do
        case "$arg" in
            --zed)
                BUILD_PROFILE="zed"
                ;;
            --loone)
                BUILD_PROFILE="loone"
                ;;
            -n|--no-cache)
                BUILD_CACHE="--no-cache"
                ;;
            -v|--virtual)
                BUILD_FOR_HARDWARE="ZED_WRAPPER_GIT_REF=virtual"
                ;;
            -x|--zedx)
                BUILD_FOR_HARDWARE="ZED_WRAPPER_GIT_REF=zedx"
                ;;
            *)
                echo "Error: unknown build option '$arg'."
                echo "Allowed options: --zed, --loone, -n|--no-cache, -v|--virtual, -x|--zedx."
                return 1
                 ;;
        esac
    done
    

    # Determine build profile based on options.
    if [ -z "$BUILD_PROFILE" ]; then
        BUILD_PROFILE=""
    fi

    # call compose build with the appropriate arguments
    echo "Building with profile: ${BUILD_PROFILE:-all}, cache: ${BUILD_CACHE:-enabled}, hardware config: ${BUILD_FOR_HARDWARE:+$BUILD_FOR_HARDWARE}"
    case "$BUILD_PROFILE" in
        zed)
            docker compose -f "$COMPOSE_FILE" build $BUILD_CACHE --build-arg $BUILD_FOR_HARDWARE zed
            ;;
        loone)

            docker compose -f "$COMPOSE_FILE" build $BUILD_CACHE --build-arg $BUILD_FOR_HARDWARE loone
            ;;
        "")
            docker compose -f "$COMPOSE_FILE" build $BUILD_CACHE --build-arg $BUILD_FOR_HARDWARE
            ;;
        *)
            echo "Error: invalid build profile '$BUILD_PROFILE'."
            return 1
            ;;
    esac
}

# Check whether the target container is currently running.
# Version: 2.0.0
# Returns:
#   0: if the container is running.
#   1: if the container is not running.
is_container_running() {
    if docker ps --filter "name=^/${IMAGE_NAME}$" --filter "status=running" --format '{{.Names}}' | grep -xq "${IMAGE_NAME}"; then
        return 0 # Running
    else
        return 1 # Not running
    fi
}

# Start the Docker container using Docker Compose.
# Version: 3.1.0
# Returns:
#   0: if the container starts successfully or is already running.
#   1: if there is an error starting the container.
start_container() {
    echo "Starting containers..."
    docker compose -f "$COMPOSE_FILE" up || { echo "Failed to start container 'zed'."; return 1; }
}

# Check whether the target Docker image exists locally.
# Version: 2.0.0
# Returns:
#   0: if the image exists.
#   1: if the image does not exist.
is_image_built() {
    if docker image inspect "$IMAGE_NAME" &> /dev/null; then
        return 0 # Image exists
    else
        return 1 # Image does not exist
    fi
}

# Enter an interactive shell inside the running target container.
# Version: 2.0.0
# Returns:
#   0: if container shell is entered and exits normally.
#   1: if the container is not running or does not exist.
enter_container() {
    xhost +local:root
    xhost +local:docker

    # Check if the container is running
    if ! is_container_running; then
        echo "Container '$IMAGE_NAME' is not running or does not exist."
        echo "Start it with LoonS ${IMAGE_NAME} (or equivalent) first."
        exit 1
    fi

    docker exec -it "$IMAGE_NAME" bash 
}

# Configure display and xauth before compose commands.
setup_x11() {
    export DISPLAY="${DISPLAY:-:1}"
    local host_xauth="${XAUTHORITY:-$HOME/.Xauthority}"
    local docker_xauth="/tmp/.docker.xauth"

    if command -v xauth >/dev/null 2>&1; then
        touch "$docker_xauth"
        xauth nlist "$DISPLAY" | sed -e 's/^..../ffff/' | xauth -f "$docker_xauth" nmerge - >/dev/null 2>&1 || true
        chmod 644 "$docker_xauth"
        export XAUTHORITY="$docker_xauth"
    else
        export XAUTHORITY="$host_xauth"
    fi

    if [ ! -f "$XAUTHORITY" ]; then
        echo "Warning: Xauthority file not found at '$XAUTHORITY'. X11 apps like rviz2 may fail to start."
    fi

    DISPLAY="$DISPLAY" xhost +local:root
    DISPLAY="$DISPLAY" xhost +local:docker
}


# Build and start the Docker Compose services for Zedx and Loon-E.
# Parameters:
#   $1 (optional): 1 to enable --no-cache, 0 otherwise.
# Returns:
#   0: if compose build and startup complete successfully.
#   non-zero: if Docker Compose commands fail.
run_services() {
    local no_cache="${1:-0}"

    setup_x11
    echo Building zed and loone containers...
    if [ "$no_cache" -eq 1 ]; then
        build --no-cache || { echo "Build failed. Aborting."; return 1; }
    else
        build || { echo "Build failed. Aborting."; return 1; }
    fi
    echo Starting services with Docker Compose...
    docker compose -f "$COMPOSE_FILE" up -d || { echo "Failed to start services. Aborting."; return 1; }
}

# Parse the first CLI option and dispatch the matching command handler.
# Version: 2.0.0
# Update: 3.1.0 
# Parameters:
#   $1 (optional): command option flag to execute (default: none).
# Returns:
#   0: if the selected command completes successfully.
#   1: if no valid option is provided.
parse_arguments() {
    case "${1:-}" in
        -s|--start)
            if is_container_running; then
                echo "Container '$IMAGE_NAME' is already running."
            else
                echo "Container '$IMAGE_NAME' is not running. Starting it..."
                start_container || exit 1
            fi
            ;;
        --stop)
            # Check if there are services
            echo "Checking for running services to stop..."
            services=$(docker ps -q)
            if [ -z "$services" ]; then
                echo "No running services found to stop."
                exit 0
            fi
            stop_services "${@:2}" || exit 1
            ;;
        -e|--enter)
            enter_container
            ;;
        -b|--build)
            build "${@:2}" || exit 1
            # Notify user of build completion and show resulting image(s)
            echo "Build completed. Showing all images:"
            docker images
            exit 0
            ;;
        -h|--help)
            show_help
            ;;
        -q|--quack)
            echo "Quack!"
            ;;
        -v|--version)
            echo "Loon-Env version ${LOON_ENV_VERSION}"
            echo "LoonE version ${LOONE_VERSION}"
            echo "Quack! Am I a boat or a duck?"
            ;;
        *) 
            echo "No valid option provided. Use -h or --help for usage information."
            exit 1
            ;;
    esac
}

parse_arguments "$@"
